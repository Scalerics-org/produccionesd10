{
  "name": "produccionesd10",
  "compatibility_date": "2026-09-01",

  /*
    TODO: pegar el account_id de la cuenta de Scalerics antes del primer deploy.
    Sin esta línea, si wrangler está logueado con una cuenta personal el sitio
    del cliente queda fuera del control de la agencia.
  */
  "account_id": "<cuenta de Scalerics>",

  /*
    El sitio es estático. El Worker existe sólo para POST /api/contacto: todo
    lo demás cae en `env.ASSETS` y se sirve tal cual, sin pasar por código.
  */
  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sin barra final: /trabajos sirve directo, sin el 307.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },

  "observability": { "enabled": true },
}
