{
  "name": "produccionesd10",
  "compatibility_date": "2026-09-01",

  // Cuenta de Scalerics: el sitio del cliente queda bajo control de la agencia.
  "account_id": "79da115d272d36fd6ac8a5b08291642e",

  /*
    El sitio es estático. El Worker existe sólo para POST /api/contacto: todo
    lo demás cae en `env.ASSETS` y se sirve tal cual, sin pasar por código.
  */
  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sin barra final: /trabajos sirve directo, sin el 307.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },

  "observability": { "enabled": true },
}
