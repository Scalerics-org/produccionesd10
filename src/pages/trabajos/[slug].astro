---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListaNumerada from '../../componentes/ListaNumerada.astro';
import VisualTrabajo from '../../componentes/VisualTrabajo.astro';
import {
  fichaDeTrabajo,
  kickerDeTrabajo,
  nombreDePilar,
  obtenerTrabajos,
  vecinosDe,
  visualDeTrabajo,
} from '../../datos/consultas';

/*
  Ficha de caso: el patrón de 2b (Noche D10) que el diseño aplica a todos los
  casos, y su versión de celular (3e).
*/
export async function getStaticPaths() {
  const trabajos = await obtenerTrabajos();
  return trabajos.map((trabajo) => ({
    params: { slug: trabajo.id },
    props: { trabajo },
  }));
}

const { trabajo } = Astro.props;
const datos = trabajo.data;
const { Content } = await render(trabajo);

const [kicker, nombrePilar, ficha, [anterior, siguiente]] = await Promise.all([
  kickerDeTrabajo(trabajo),
  nombreDePilar(datos.pilar),
  fichaDeTrabajo(trabajo),
  vecinosDe(trabajo),
]);
const visual = visualDeTrabajo(trabajo);
const faltanFotos = datos.galeria.some((foto) => foto.esPlaceholder);
const hayResultado = datos.cifras.length > 0 || datos.resultado !== null;
---

<Base titulo={datos.titulo} descripcion={datos.resumen}>
  <nav
    aria-label="Migas"
    class="bg-hueso border-tinta/25 rotulo text-humo lg:px-marco border-b px-4 py-[11px] lg:py-3"
  >
    <a href="/trabajos" class="hover:text-tinta">Trabajos</a>
    <span aria-hidden="true"> · </span>
    <a href={`/trabajos/pilar/${datos.pilar}`} class="hover:text-tinta">{nombrePilar}</a
    >
    <span aria-hidden="true"> · </span>
    <span class="text-rojo" aria-current="page">{datos.titulo}</span>
  </nav>

  <section
    class="trama-oscura text-hueso lg:px-marco grid items-end lg:grid-cols-[1.3fr_1fr] lg:gap-[46px] lg:pt-11"
  >
    <div class="px-4 pt-6 pb-5 lg:px-0 lg:pt-0 lg:pb-10">
      <p
        class="kicker text-rojo-claro mb-3 text-[10px] tracking-[0.18em] lg:mb-4 lg:text-[11px] lg:tracking-[0.2em]"
      >
        {kicker}
      </p>
      <h1
        class="titular mb-3.5 text-[54px] leading-[0.92] lg:mb-[18px] lg:text-[76px] lg:leading-[0.93]"
      >
        {datos.titulo}
      </h1>
      <p class="text-ceniza max-w-[48ch] text-[15px] text-pretty lg:text-lg">
        {datos.resumen}
      </p>
      {
        datos.esPlaceholder && (
          <p class="bg-rojo text-hueso mt-5 inline-block px-3 py-2 text-[13px]">
            <strong>Ficha provisoria.</strong> Está para que se vea la plantilla: falta
            el material del cliente.
          </p>
        )
      }
    </div>
    <div class="border-hueso/20 lg:border-l">
      <VisualTrabajo visual={visual} alto={260} />
    </div>
  </section>

  <dl
    class="bg-tinta text-hueso border-rojo lg:px-lienzo grid border-t-2 lg:grid-cols-4"
  >
    {
      ficha.map((dato, i) => (
        <div
          class:list={[
            'border-hueso/20 lg:px-marco flex flex-col-reverse p-4 lg:pt-[22px] lg:pb-6',
            i < ficha.length - 1 && 'border-b lg:border-r lg:border-b-0',
          ]}
        >
          <dd class="text-[17px] leading-[1.2] font-extrabold">{dato.valor}</dd>
          <dt class="rotulo text-niebla mb-[7px] lg:mb-[9px]">{dato.rotulo}</dt>
        </div>
      ))
    }
  </dl>

  <section
    class="bg-hueso lg:px-marco grid gap-4 px-4 pt-6 pb-[26px] lg:grid-cols-[0.75fr_1.25fr] lg:gap-[46px] lg:pt-9 lg:pb-10"
  >
    <div>
      <h2 class="mb-3 text-[26px] leading-[1.05] tracking-[-0.03em] lg:text-[30px]">
        Qué se hizo
      </h2>
      <div class="text-humo hidden text-sm lg:block [&_p]:mb-3">
        <Content />
      </div>
    </div>
    {
      datos.hicimos.length > 0 ? (
        <ListaNumerada items={datos.hicimos} />
      ) : (
        <div class="text-humo border-tinta border-t-2 pt-4 text-sm lg:hidden [&_p]:mb-3">
          <Content />
        </div>
      )
    }
  </section>

  {
    datos.galeria.length > 0 && (
      <section class="bg-hueso-hondo border-tinta lg:px-marco border-t-2 px-4 pt-[22px] pb-[26px] lg:pt-8 lg:pb-[38px]">
        <div class="mb-3.5 flex flex-wrap items-baseline justify-between gap-2 lg:mb-[18px]">
          <h2 class="text-[26px] leading-none tracking-[-0.03em] lg:text-[30px]">
            Galería
          </h2>
          {faltanFotos && (
            /* TODO: material pendiente del cliente. */
            <p class="rotulo text-rojo">Fotos provisorias · faltan las reales</p>
          )}
        </div>
        <ul class="celdas-con-reglas border-tinta grid auto-rows-[120px] grid-cols-2 gap-0.5 border-2 lg:auto-rows-[150px] lg:grid-cols-4">
          {datos.galeria.map((foto, i) => (
            <li
              class:list={[
                'bg-carbon relative overflow-hidden',
                i === 0 && 'col-span-2 lg:row-span-2',
              ]}
            >
              <Image
                src={foto.imagen}
                alt={foto.alt}
                widths={[480, 960]}
                sizes={
                  i === 0
                    ? '(min-width: 1024px) 560px, 100vw'
                    : '(min-width: 1024px) 280px, 50vw'
                }
                loading="lazy"
                class="foto-byn absolute inset-0 h-full w-full object-cover"
              />
              {foto.esPlaceholder && (
                <span class="rotulo bg-tinta text-hueso absolute top-2 left-2 px-2 py-1">
                  Foto provisoria
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hayResultado && (
      <section class="bg-rojo text-hueso lg:px-marco px-4 pt-6 pb-7 lg:pt-9 lg:pb-10">
        <h2 class="kicker mb-4 text-[10px] tracking-[0.18em] lg:mb-5 lg:text-[11px] lg:tracking-[0.2em]">
          Resultado
        </h2>
        {datos.cifras.length > 0 && (
          <dl class="bg-hueso/40 border-hueso mb-[18px] grid grid-cols-2 gap-0.5 border-2 lg:mb-6 lg:grid-cols-4">
            {datos.cifras.map((cifra) => (
              <div class="bg-rojo flex flex-col-reverse px-3 py-3.5 lg:px-[18px] lg:pt-5 lg:pb-[22px]">
                <dt class="rotulo mt-[7px] text-[9px] tracking-[0.13em] lg:mt-[9px] lg:text-[10px]">
                  <span class="lg:hidden">{cifra.corta}</span>
                  <span class="hidden lg:inline">{cifra.etiqueta}</span>
                </dt>
                <dd class="text-[32px] leading-none font-extrabold tracking-[-0.035em] lg:text-5xl lg:tracking-[-0.04em]">
                  {cifra.valor}
                </dd>
              </div>
            ))}
          </dl>
        )}
        {datos.resultado && (
          <p class="max-w-[64ch] text-[15px] text-pretty lg:text-[17px]">
            {datos.resultado}
          </p>
        )}
      </section>
    )
  }

  <nav
    aria-label="Otros casos"
    class="bg-hueso border-tinta lg:px-marco flex flex-col gap-4 border-t-2 px-4 py-6 lg:flex-row lg:items-center lg:justify-between lg:gap-[30px] lg:py-[30px]"
  >
    <div class="flex flex-wrap gap-x-[26px] gap-y-2">
      <a
        href={`/trabajos/${anterior.id}`}
        class="kicker hover:text-rojo tracking-[0.12em]"
      >
        ← Caso anterior<span class="sr-only">: {anterior.data.titulo}</span>
      </a>
      <a
        href={`/trabajos/${siguiente.id}`}
        class="kicker hover:text-rojo tracking-[0.12em]"
      >
        Caso siguiente →<span class="sr-only">: {siguiente.data.titulo}</span>
      </a>
    </div>
    <a href="/contacto" class="boton bg-rojo text-hueso hover:bg-rojo-hondo">
      Quiero algo así <span aria-hidden="true">→</span>
    </a>
  </nav>
</Base>
