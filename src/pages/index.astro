---
import Base from '../layouts/Base.astro';
import Hero from '../componentes/Hero.astro';
import Contadores from '../componentes/Contadores.astro';
import AcordeonPilares from '../componentes/AcordeonPilares.astro';
import GrillaTrabajos from '../componentes/GrillaTrabajos.astro';
import CarruselLogos from '../componentes/CarruselLogos.astro';
import CasoDestacado from '../componentes/CasoDestacado.astro';
import FormularioContacto from '../componentes/FormularioContacto.astro';
import CanalDirecto from '../componentes/CanalDirecto.astro';
import DatosDeContacto from '../componentes/DatosDeContacto.astro';
import { obtenerDestacados } from '../datos/consultas';
import { home } from '../datos/home';
import { contacto } from '../datos/sitio';

/* El orden de las secciones es el de la pantalla 1d del diseño. */
const destacados = await obtenerDestacados(6);
---

<Base
  titulo="Inicio"
  precargar={{ href: '/video/hero-poster.avif', tipo: 'image/avif' }}
  cabezalInvertido
>
  <Hero />
  <Contadores />
  <AcordeonPilares />

  <section class="bg-hueso lg:px-marco px-4 pt-6 pb-7 lg:pt-9 lg:pb-10">
    <div class="mb-4 flex items-baseline justify-between gap-4 lg:mb-[22px]">
      <h2 class="text-[26px] leading-none tracking-[-0.03em] lg:text-[32px]">
        {home.destacados.titulo}
      </h2>
      <a
        href={home.destacados.enlace.href}
        class="kicker border-rojo hidden border-b-2 pb-1 tracking-[0.14em] lg:inline-block"
      >
        {home.destacados.enlace.texto}
      </a>
    </div>

    <GrillaTrabajos trabajos={destacados} />

    <a
      href={home.destacados.enlace.href}
      class="boton border-tinta hover:bg-tinta hover:text-hueso mt-4 w-full border-2 lg:hidden"
    >
      {home.destacados.enlace.texto}
    </a>
  </section>

  <CarruselLogos />
  <CasoDestacado />

  <section
    class="bg-hueso fondo-partido border-tinta lg:px-lienzo grid border-t-2 lg:grid-cols-[1.15fr_1fr]"
    aria-labelledby="titulo-contacto-home"
  >
    <div
      class="bg-hueso border-tinta lg:px-marco px-4 pt-[26px] pb-[30px] lg:border-r-2 lg:py-9"
    >
      <h2
        id="titulo-contacto-home"
        class="mb-2 text-[28px] leading-none tracking-[-0.03em] lg:text-[34px]"
      >
        {home.contacto.titulo}
      </h2>
      <p class="text-humo mb-[18px] text-sm lg:mb-[22px]">{contacto.bajadaCorta}</p>
      <FormularioContacto />
    </div>

    <div class="bg-hueso-hondo lg:px-marco flex flex-col gap-5 px-4 py-[26px] lg:py-9">
      <p class="kicker text-rojo">{home.contacto.directo}</p>
      <CanalDirecto tono="tinta" />
      <div class="border-tinta/35 border-t-2 pt-[18px]">
        <DatosDeContacto />
      </div>
    </div>
  </section>
</Base>
