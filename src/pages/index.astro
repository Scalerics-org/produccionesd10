---
import Base from '../layouts/Base.astro';
import Hero from '../componentes/Hero.astro';
import Contadores from '../componentes/Contadores.astro';
import AcordeonPilares from '../componentes/AcordeonPilares.astro';
import CarruselLogos from '../componentes/CarruselLogos.astro';
import TarjetaTrabajo from '../componentes/TarjetaTrabajo.astro';
import { obtenerDestacados } from '../datos/consultas';

const destacados = await obtenerDestacados(6);
---

<Base
  titulo="Inicio"
  precargar={{ href: '/video/hero-poster.avif', tipo: 'image/avif' }}
>
  <Hero />
  <Contadores />
  <AcordeonPilares />

  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-titulo text-3xl font-black sm:text-4xl">Trabajos</h2>
        <p class="text-grafito mt-2">Una muestra de lo que producimos.</p>
      </div>
      <a
        href="/trabajos"
        class="text-rojo hover:text-rojo-hondo font-semibold underline-offset-4 hover:underline"
      >
        Ver todo el portfolio →
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        /* En la home las tarjetas quedan lejos del primer pantallazo: van
           todas diferidas para no competir con el poster, que es el LCP. */
        destacados.map((trabajo) => <TarjetaTrabajo trabajo={trabajo} />)
      }
    </div>
  </section>

  <div class="mt-16">
    <CarruselLogos />
  </div>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center">
    <h2 class="font-titulo text-3xl font-black text-balance sm:text-4xl">
      ¿Tenés un proyecto? Contanos y te pasamos un presupuesto.
    </h2>
    <p class="text-grafito mx-auto mt-4 max-w-xl text-pretty">
      Un evento, un institucional, un programa o un podcast. Escribinos qué necesitás y
      te respondemos con una propuesta concreta.
    </p>
    <p class="mt-8">
      <a
        href="/contacto"
        class="bg-rojo hover:bg-rojo-hondo inline-block px-8 py-4 font-semibold text-white transition-colors"
      >
        Pedir presupuesto
      </a>
    </p>
  </section>
</Base>
