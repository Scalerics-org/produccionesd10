---
import Base from '../layouts/Base.astro';
import { gracias } from '../datos/sitio';

/*
  El estado "consulta enviada" de 3f, como página propia: el Worker redirige acá.
  Qué botones van lo decide `gracias` en el dominio: sin número de WhatsApp no
  se promete WhatsApp.
*/
---

<Base titulo="Consulta enviada" descripcion="Recibimos tu consulta." sinBotonFlotante>
  <section class="bg-hueso lg:px-marco px-4 py-14 lg:py-24">
    <div class="border-tinta max-w-xl border-2 p-[22px] lg:p-8">
      <h1 class="mb-2.5 text-[34px] leading-[1.05] tracking-[-0.03em]">
        {gracias.titulo}
      </h1>
      <p class="text-humo mb-[18px] text-sm leading-normal">{gracias.texto}</p>
      <div class="flex flex-col gap-0.5">
        {
          gracias.canal && (
            <a
              href={gracias.canal.href}
              class="boton bg-tinta text-hueso hover:bg-carbon"
              target="_blank"
              rel="noopener noreferrer"
            >
              {gracias.canal.texto} <span aria-hidden="true">→</span>
            </a>
          )
        }
        <a
          href={gracias.trabajos.href}
          class:list={[
            'boton border-tinta border-2',
            gracias.canal
              ? 'hover:bg-tinta hover:text-hueso'
              : 'bg-tinta text-hueso hover:bg-carbon',
          ]}
        >
          {gracias.trabajos.texto}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>
