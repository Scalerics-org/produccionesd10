---
import Base from '../layouts/Base.astro';
import { redes } from '../datos/sitio';
---

<Base
  titulo="Consulta enviada"
  descripcion="Recibimos tu consulta. Te respondemos a la brevedad."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-rojo font-titulo text-5xl font-black" aria-hidden="true">✓</p>
    <h1 class="font-titulo mt-6 text-4xl font-black text-balance">
      Recibimos tu consulta
    </h1>
    <p class="text-grafito mt-4 text-lg text-pretty">
      Te respondemos a la brevedad con una propuesta. Mientras tanto, podés ver en qué
      andamos.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/trabajos"
        class="bg-tinta hover:bg-rojo px-6 py-3 font-semibold text-white transition-colors"
      >
        Ver trabajos
      </a>
      {
        redes.slice(0, 1).map((red) => (
          <a
            href={red.href}
            rel="noopener"
            target="_blank"
            class="border-borde hover:border-tinta border px-6 py-3 font-semibold transition-colors"
          >
            Seguinos en {red.nombre}
          </a>
        ))
      }
    </div>
  </section>
</Base>
