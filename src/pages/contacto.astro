---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../componentes/FormularioContacto.astro';
import { redes, sitio } from '../datos/sitio';
---

<Base titulo="Contacto" descripcion="Contanos tu proyecto y te pasamos un presupuesto.">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-titulo text-4xl font-black sm:text-5xl">Contanos tu proyecto</h1>
    <p class="text-grafito mt-4 max-w-2xl text-lg text-pretty">
      Un evento, un institucional, un programa o un podcast. Escribinos qué necesitás y
      te respondemos con una propuesta concreta.
    </p>

    <FormularioContacto />

    <aside class="border-borde mt-16 border-t pt-8">
      <h2 class="text-plomo text-xs font-semibold tracking-widest uppercase">
        También nos encontrás en
      </h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.href}
                rel="noopener"
                target="_blank"
                class="hover:text-rojo font-semibold underline-offset-4 hover:underline"
              >
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
      {
        /* TODO: material pendiente del cliente. Teléfono, WhatsApp, mail y
           dirección. Mientras no estén, las redes son la única vía verificable
           que tenemos: no se inventa ninguna. */
        !sitio.telefono && !sitio.email && (
          <p class="text-plomo mt-6 text-sm">
            Teléfono y mail directos: pendientes de que el cliente nos los pase.
          </p>
        )
      }
    </aside>
  </section>
</Base>
