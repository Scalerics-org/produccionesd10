---
import Base from '../layouts/Base.astro';
import Contadores from '../componentes/Contadores.astro';
import { empresa, equipo } from '../datos/empresa';
import { obtenerServicios } from '../datos/consultas';

const servicios = await obtenerServicios();
const sinConfirmar = equipo.some((persona) => persona.bio === null);
---

<Base
  titulo="Nosotros"
  descripcion="16 años produciendo radio, televisión, eventos y podcasts en Uruguay."
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-titulo text-4xl font-black sm:text-5xl">Nosotros</h1>
    <p class="text-grafito mt-6 text-xl text-pretty">
      {empresa.aniosDeTrayectoria} años produciendo radio, televisión, eventos y podcasts
      en Uruguay. Desde {empresa.fundacion}, sin cortar.
    </p>
    <p class="text-grafito mt-4 text-pretty">
      Producciones D10 nació alrededor de un programa y terminó siendo una casa
      productora: la misma estructura que sostiene una emisión semanal — producción,
      técnica, contenidos y contacto con artistas — es la que hoy produce eventos y
      contenido audiovisual para terceros.
    </p>
  </section>

  <Contadores />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="font-titulo text-2xl font-black">Qué hacemos</h2>
    <ul class="border-borde mt-6 border-t">
      {
        servicios.map((servicio) => (
          <li class="border-borde flex flex-wrap items-baseline gap-x-4 border-b py-4">
            <a
              href={`/servicios/${servicio.id}`}
              class="hover:text-rojo font-titulo text-lg font-black"
            >
              {servicio.data.nombre}
            </a>
            <span class="text-plomo text-sm">{servicio.data.bajada}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="font-titulo text-2xl font-black">Equipo</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        equipo.map((persona) => (
          <li class="border-borde border p-6">
            <p class="font-titulo text-lg font-black">{persona.nombre}</p>
            <p class="text-rojo mt-1 text-sm font-semibold">{persona.rol}</p>
            {persona.bio ? (
              <p class="text-grafito mt-4 text-sm text-pretty">{persona.bio}</p>
            ) : (
              /* TODO: material pendiente del cliente. */
              <p class="text-plomo mt-4 text-sm italic">Bio pendiente.</p>
            )}
          </li>
        ))
      }
    </ul>

    {
      sinConfirmar && (
        <p class="text-plomo border-borde mt-8 border-l-2 pl-4 text-sm">
          El equipo completo y las fotos están pendientes del cliente.
        </p>
      )
    }
  </section>
</Base>
