---
import { obtenerServicios } from '../datos/consultas';
import { avisoDelFormulario, campos, textosDelFormulario } from '../datos/formulario';
import { contacto } from '../datos/sitio';

/*
  Formulario de presupuesto.

  Validación nativa del navegador — `required`, `pattern`, `minlength` — y nada
  de JS para validar. Los estados de error del diseño (3f: rótulo y borde en
  rojo, con una línea que explica qué falta) salen de `:user-invalid`, que
  recién se activa cuando la persona tocó el campo o intentó enviar: no se pinta
  todo de rojo al cargar la página. El error no depende sólo del color: la línea
  lleva una ✕ y está atada al campo con `aria-describedby`.

  El foco usa la geometría del anillo global (2 px, separado 2 px) pero en tinta:
  en el formulario el rojo ya quiere decir error, y un campo enfocado no puede
  parecer un campo con error (17,83:1 sobre hueso). El borde del campo nunca se
  pone rojo por el foco: rojo en el borde quiere decir error, y nada más.

  El único JS es el estado "enviando": evita el doble envío y dice qué pasa.

  El honeypot está escondido para las personas y visible para un bot que
  completa todo lo que encuentra. Va con `hidden`, `tabindex="-1"` y
  `autocomplete="off"`: no se alcanza tabulando ni lo rellena el navegador.
*/
type Props = { compacto?: boolean };

const { compacto = false } = Astro.props;
const servicios = await obtenerServicios();

/*
  `tinta/60` da 5,08:1 sobre hueso: el borde del campo se distingue aunque no
  tenga foco (con `tinta/40` daba 2,67:1). El hover lo lleva a tinta plena.
*/
const estiloCampo =
  'border-tinta/60 not-user-invalid:hover:border-tinta focus-visible:outline-tinta user-invalid:border-rojo user-invalid:border-2 placeholder:text-plomo w-full border bg-transparent px-[13px] py-[13px] text-[15px] lg:text-sm';
const estiloRotulo =
  'rotulo text-humo group-has-[:user-invalid]:text-rojo mb-1.5 block';
const estiloOpcional = 'text-plomo ml-1 font-normal tracking-normal normal-case';
const estiloError =
  'text-rojo mt-[7px] hidden gap-1.5 text-[12px] leading-[1.3] font-semibold group-has-[:user-invalid]:flex';
---

<form
  id="formulario"
  method="post"
  action="/api/contacto"
  class="scroll-mt-24"
  data-formulario-consulta
>
  {
    avisoDelFormulario && (
      <p class="border-rojo bg-hueso-hondo mb-[22px] border-l-2 px-4 py-3 text-[13px] leading-normal">
        {avisoDelFormulario.texto}{' '}
        {avisoDelFormulario.redes.map((red, i) => (
          <>
            {i > 0 && ' o '}
            <a
              href={red.href}
              rel="noopener"
              target="_blank"
              class="decoration-rojo font-semibold underline decoration-2 underline-offset-4"
            >
              {red.nombre}
            </a>
          </>
        ))}
        .
      </p>
    )
  }

  <div hidden aria-hidden="true">
    <label>
      No completar este campo
      <input type="text" name={campos.honeypot} tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <fieldset class="group mb-[22px]" aria-describedby="error-tipo">
    <legend class={estiloRotulo}>{campos.tipo.rotulo}</legend>
    <div
      class="border-tinta/60 group-has-[:user-invalid]:border-rojo grid grid-cols-2 border group-has-[:user-invalid]:border-2 sm:flex"
    >
      {
        servicios.map((servicio, i) => (
          <label
            class:list={[
              'kicker has-[:checked]:bg-tinta has-[:checked]:text-hueso hover:bg-hueso-hondo has-[:focus-visible]:outline-rojo text-humo flex min-h-12 flex-1 cursor-pointer items-center px-3 tracking-[0.06em] has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2',
              i % 2 === 1 && 'border-tinta/60 border-l',
              i >= 2 && 'border-tinta/60 border-t sm:border-t-0',
              i === 2 && 'sm:border-l',
            ]}
          >
            <input
              type="radio"
              name={campos.tipo.nombre}
              value={servicio.id}
              required
              class="sr-only"
            />
            {servicio.data.nombre}
          </label>
        ))
      }
    </div>
    <p id="error-tipo" class={estiloError}>
      <span aria-hidden="true">✕</span>
      {campos.tipo.error}
    </p>
  </fieldset>

  <div class:list={['grid gap-x-[18px] gap-y-4', !compacto && 'sm:grid-cols-2']}>
    <p class="group">
      <label class={estiloRotulo} for="campo-nombre">{campos.nombre.rotulo}</label>
      <input
        id="campo-nombre"
        type="text"
        name={campos.nombre.nombre}
        required
        autocomplete="name"
        maxlength={campos.nombre.maximo}
        placeholder={campos.nombre.ayuda}
        aria-describedby="error-nombre"
        class={estiloCampo}
      />
      <span id="error-nombre" class={estiloError}>
        <span aria-hidden="true">✕</span>
        {campos.nombre.error}
      </span>
    </p>

    <p>
      <label class={estiloRotulo} for="campo-empresa">
        {campos.empresa.rotulo}
        <span class={estiloOpcional}>{textosDelFormulario.opcional}</span>
      </label>
      <input
        id="campo-empresa"
        type="text"
        name={campos.empresa.nombre}
        autocomplete="organization"
        maxlength={campos.empresa.maximo}
        placeholder={campos.empresa.ayuda}
        class={estiloCampo}
      />
    </p>

    <p class="group">
      <label class={estiloRotulo} for="campo-contacto">{campos.contacto.rotulo}</label>
      <input
        id="campo-contacto"
        type="text"
        inputmode="text"
        name={campos.contacto.nombre}
        required
        autocomplete="email"
        maxlength={campos.contacto.maximo}
        pattern={campos.contacto.patron}
        placeholder={campos.contacto.ayuda}
        aria-describedby="error-contacto"
        class={estiloCampo}
      />
      <span id="error-contacto" class={estiloError}>
        <span aria-hidden="true">✕</span>
        {campos.contacto.error}
      </span>
    </p>

    <p>
      <label class:list={[estiloRotulo, '!mb-0.5']} for="campo-fecha">
        {campos.fecha.rotulo}
        <span class={estiloOpcional}>{textosDelFormulario.opcional}</span>
      </label>
      <span id="formato-fecha" class="text-plomo mb-1.5 block text-xs">
        {campos.fecha.formato}
      </span>
      <input
        id="campo-fecha"
        type="text"
        name={campos.fecha.nombre}
        maxlength={campos.fecha.maximo}
        aria-describedby="formato-fecha"
        class={estiloCampo}
      />
    </p>
  </div>

  <p class="group mt-4">
    <label class={estiloRotulo} for="campo-mensaje">{campos.mensaje.rotulo}</label>
    <textarea
      id="campo-mensaje"
      name={campos.mensaje.nombre}
      required
      rows="4"
      minlength={campos.mensaje.minimo}
      maxlength={campos.mensaje.maximo}
      placeholder={campos.mensaje.ayuda}
      aria-describedby="error-mensaje"
      class:list={[estiloCampo, 'min-h-[104px] resize-y']}></textarea>
    <span id="error-mensaje" class={estiloError}>
      <span aria-hidden="true">✕</span>
      {campos.mensaje.error}
    </span>
  </p>

  <div class="mt-[22px] flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-[18px]">
    <button
      type="submit"
      data-texto-enviando={textosDelFormulario.enviando}
      class="boton bg-rojo text-hueso hover:bg-rojo-hondo active:bg-rojo-hondo aria-disabled:bg-rojo-hondo min-h-[52px] cursor-pointer px-6 text-[13px] aria-disabled:cursor-progress"
    >
      {textosDelFormulario.enviar}
    </button>
    <p class="text-humo max-w-[30ch] text-xs leading-[1.45]">{contacto.privacidad}</p>
  </div>
</form>

<script is:inline>
  // Estado "enviando". El submit sólo llega acá si la validación nativa pasó.
  (() => {
    const formulario = document.querySelector('[data-formulario-consulta]');
    const boton = formulario?.querySelector('button[type="submit"]');
    if (!formulario || !boton) return;
    const textoOriginal = boton.textContent;
    formulario.addEventListener('submit', (evento) => {
      if (boton.getAttribute('aria-disabled') === 'true') {
        evento.preventDefault();
        return;
      }
      boton.setAttribute('aria-disabled', 'true');
      boton.textContent = boton.dataset.textoEnviando;
    });
    // Al volver con el botón "atrás" la página sale del bfcache tal como quedó:
    // sin esto el botón seguiría diciendo "Enviando consulta…".
    addEventListener('pageshow', (evento) => {
      if (!evento.persisted) return;
      boton.removeAttribute('aria-disabled');
      boton.textContent = textoOriginal;
    });
  })();
</script>
