---
import { navegacion, sitio } from '../datos/sitio';

const rutaActual = Astro.url.pathname;

/** Una sección está activa si estamos en ella o en cualquier ficha de adentro. */
const estaActivo = (href: string) =>
  rutaActual === href || rutaActual.startsWith(`${href}/`);
---

<header class="border-borde bg-papel/90 sticky top-0 z-30 border-b backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4">
    <a href="/" class="font-titulo text-lg font-black tracking-tight">
      Producciones <span class="text-rojo">D10</span>
      <span class="sr-only">— inicio</span>
    </a>

    <nav aria-label="Principal" class="order-3 w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          navegacion.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={estaActivo(item.href) ? 'page' : undefined}
                class="text-grafito hover:text-tinta aria-[current=page]:text-tinta aria-[current=page]:decoration-rojo transition-colors aria-[current=page]:font-semibold aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/contacto"
      class="bg-tinta hover:bg-rojo ml-auto px-4 py-2 text-sm font-semibold text-white transition-colors"
    >
      Pedir presupuesto
    </a>
  </div>
  <span class="sr-only">{sitio.descripcion}</span>
</header>
