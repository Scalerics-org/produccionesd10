---
/*
  Logo de la marca: el sello circular "Canal D10 Producciones" que mandó el
  cliente en noviembre de 2026 (PNG transparente de 8000 px; acá va una copia de
  512 px y Astro genera los tamaños que se usan).

  Es la marca del cliente tal cual, con su bisel y su metalizado: no se redibuja
  ni se aplana para que combine con el sistema. El nombre accesible lo pone el
  link que lo envuelve, así que la imagen va con alt vacío.
*/
import { Image } from 'astro:assets';
import selloCanalD10 from '../datos/marca/canal-d10.png';

type Props = { grande?: boolean };

/* 44 px en el cabezal, para no agrandar la barra fija; 72 px en el pie. */
const { grande = false } = Astro.props;
const lado = grande ? 72 : 44;
---

<Image
  src={selloCanalD10}
  alt=""
  width={lado}
  height={lado}
  densities={[1, 2]}
  loading="eager"
  class="block shrink-0"
/>
