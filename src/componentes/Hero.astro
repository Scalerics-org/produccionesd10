---
/*
  Hero del home.

  El orden importa y no es casual:

  1. El poster se pinta primero y es el elemento LCP. Va en AVIF (8,7 KB), con
     `fetchpriority="high"` y precargado desde el `<head>`. El `<picture>` deja
     el JPEG como reserva para el navegador que no entienda AVIF: baja uno de
     los dos, nunca los dos, y el `<link rel="preload">` tampoco se dispara si
     el navegador no soporta el `type`.
  2. El `<video>` sale sin `src`: los dos `<source>` llevan la ruta en un
     `data-fuente` y el script se la pasa recién en el evento `load`, y sólo en
     viewport de escritorio. Van WebM/VP9 (29 KB) primero y MP4/H.264 (125 KB)
     de reserva: el navegador baja uno solo. Así el video no compite por ancho
     de banda con nada del render inicial: literalmente no existe hasta que la
     página terminó de cargar.

     Tampoco lleva atributo `poster`: medido, el navegador se bajaba igual el
     JPEG del poster (18,1 KB) aunque el video no tuviera `src`, y era el
     recurso crítico más pesado de la home. No hacía falta para nada, porque el
     `<img>` de atrás ya muestra exactamente esa imagen.
  3. Si el usuario pidió movimiento reducido, el video no arranca nunca y se
     queda el poster.
*/
const POSTER_AVIF = '/video/hero-poster.avif';
---

<section class="bg-tinta relative isolate overflow-hidden text-white">
  <picture>
    <source srcset={POSTER_AVIF} type="image/avif" />
    <img
      src="/video/hero-poster.jpg"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="sync"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>

  <video
    id="video-hero"
    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  >
    <source data-fuente="/video/hero.webm" type="video/webm" />
    <source data-fuente="/video/hero.mp4" type="video/mp4" />
  </video>

  <!-- El degradado es el que hace legible el título sobre cualquier fotograma. -->
  <div class="from-tinta via-tinta/85 absolute inset-0 bg-gradient-to-r to-transparent">
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-28 sm:py-36 lg:py-44">
    <p class="text-rojo-claro text-xs font-semibold tracking-[0.2em] uppercase">
      Productora · Uruguay
    </p>
    <h1
      class="font-titulo mt-5 max-w-3xl text-4xl leading-[1.05] font-black text-balance sm:text-6xl lg:text-7xl"
    >
      Hacemos televisión, radio y eventos desde hace 16 años.
    </h1>
    <p class="text-niebla mt-6 max-w-xl text-lg text-pretty">
      Producimos <a
        href="/trabajos/noche-d10"
        class="text-white underline underline-offset-4">Noche D10</a
      > todas las semanas. El mismo equipo produce eventos, contenido audiovisual y podcasts.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/contacto"
        class="bg-rojo hover:bg-rojo-hondo px-6 py-3 font-semibold text-white transition-colors"
      >
        Contanos tu proyecto
      </a>
      <a
        href="/trabajos"
        class="border border-white/30 px-6 py-3 font-semibold transition-colors hover:border-white"
      >
        Ver trabajos
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // Sin `is:inline` Astro lo empaqueta como módulo y agrega un request. Son
  // trece líneas: no vale un archivo aparte.
  addEventListener('load', () => {
    const video = document.getElementById('video-hero');
    if (!video) return;
    // En celular el video es puro costo: pantalla chica, datos caros.
    if (!matchMedia('(min-width: 1024px)').matches) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    video.addEventListener(
      'canplay',
      () => {
        video.style.opacity = '1';
        video.play().catch(() => {});
      },
      { once: true },
    );

    // Los `<source>` salen del HTML sin `src`: recién acá se los damos y
    // pedimos el `load()`. Hasta esta línea el navegador no pidió un solo byte.
    for (const fuente of video.querySelectorAll('source')) {
      fuente.src = fuente.dataset.fuente;
    }
    video.load();
  });
</script>
