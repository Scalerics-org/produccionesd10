---
import { obtenerServicios } from '../datos/consultas';
import { empresa } from '../datos/empresa';
import { redes, sitio } from '../datos/sitio';

const servicios = await obtenerServicios();
const anio = new Date().getFullYear();
---

<footer class="bg-tinta text-niebla mt-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-titulo text-xl font-black text-white">
        Producciones <span class="text-rojo-claro">D10</span>
      </p>
      <p class="mt-3 max-w-sm text-sm">{sitio.descripcion}</p>

      <p class="mt-6 text-sm">
        <a
          href="/contacto"
          class="border-rojo-claro text-white underline-offset-4 hover:underline"
        >
          Contanos tu proyecto →
        </a>
      </p>

      {
        /* TODO: material pendiente del cliente. Teléfono, mail, dirección,
           razón social y RUT. Hasta que lleguen no se muestra nada: un dato
           inventado en el pie es peor que un pie corto. */
      }
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-widest text-white uppercase">
        Servicios
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          servicios.map((servicio) => (
            <li>
              <a href={`/servicios/${servicio.id}`} class="hover:text-white">
                {servicio.data.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-widest text-white uppercase">
        Seguinos
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.href}
                class="hover:text-white"
                rel="noopener"
                target="_blank"
              >
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-borde-hondo border-t px-4 py-6 text-center text-xs">
    <p>
      © {anio}
      {empresa.nombre} · {empresa.aniosDeTrayectoria} años produciendo en Uruguay
    </p>
  </div>
</footer>
