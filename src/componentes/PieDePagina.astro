---
import Logotipo from './Logotipo.astro';
import { empresa } from '../datos/empresa';
import { navegacionDelPie, redes } from '../datos/sitio';

/*
  Pie. Negro con la regla roja arriba, como cierra cada pantalla del diseño.

  TODO: material pendiente del cliente. El diseño pone "Colonia, Uruguay", pero
  lo único que sabemos es que Luis está radicado en Colonia, no dónde está la
  empresa. Hasta que el cliente pase la dirección, razón social y RUT, el pie
  dice "Uruguay" y nada más.
*/
const anio = new Date().getFullYear();
---

<footer class="bg-tinta text-niebla border-rojo border-t-2">
  <div
    class="flex flex-col gap-6 px-4 pt-[22px] pb-24 lg:flex-row lg:items-end lg:justify-between lg:px-[34px] lg:pt-[30px] lg:pb-24"
  >
    <div>
      <a
        href="/"
        aria-label="D10 De Diez Producciones — inicio"
        class="mb-3 inline-block lg:mb-3.5"
      >
        <Logotipo invertido />
      </a>
      <p class="text-xs">
        {`© ${anio} ${empresa.nombre} · Uruguay · Razón social y RUT pendientes`}
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:items-end">
      <nav aria-label="Secciones">
        <ul class="flex flex-wrap gap-x-[18px] gap-y-2">
          {
            navegacionDelPie.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="kicker text-niebla hover:text-hueso tracking-[0.12em]"
                >
                  {item.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Redes">
        <ul class="flex flex-wrap gap-x-[18px] gap-y-2">
          {
            redes.map((red) => (
              <li>
                <a
                  href={red.href}
                  rel="noopener"
                  target="_blank"
                  class="kicker text-hueso hover:text-rojo-claro tracking-[0.12em]"
                >
                  {red.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
