---
import VisualTrabajo from './VisualTrabajo.astro';
import { kickerDeTrabajo, visualDeTrabajo, type Trabajo } from '../datos/consultas';

/*
  Tarjeta de trabajo: una celda de la grilla de reglas de 2 px del sistema.
  Las provisorias se ven apagadas y llevan el cartel rojo de "Falta material",
  para que en la demo nadie las confunda con un caso.
*/
type Props = { trabajo: Trabajo; alto?: number };

const { trabajo, alto } = Astro.props;
const { titulo, cliente, resumen, esPlaceholder } = trabajo.data;
const kicker = await kickerDeTrabajo(trabajo);
const visual = visualDeTrabajo(trabajo);
---

<article class="bg-hueso group relative">
  <VisualTrabajo visual={visual} alto={alto} />
  <div class="px-4 pt-3.5 pb-4 lg:px-[18px] lg:pt-4 lg:pb-5">
    <p class:list={['rotulo', esPlaceholder ? 'text-plomo' : 'text-rojo']}>{kicker}</p>
    <h3
      class:list={[
        'mt-2 mb-1.5 text-[22px] leading-[1.05] tracking-[-0.02em] lg:mt-[9px]',
        esPlaceholder ? 'text-plomo' : 'text-tinta',
      ]}
    >
      <a
        href={`/trabajos/${trabajo.id}`}
        class="group-hover:decoration-rojo decoration-2 underline-offset-4 group-hover:underline after:absolute after:inset-0"
      >
        {titulo}
      </a>
    </h3>
    <p class="text-humo text-[13px] leading-[1.45]">
      {cliente && <>{cliente} · </>}
      {resumen}
    </p>
    {
      esPlaceholder && (
        <p class="rotulo bg-rojo text-hueso mt-2.5 inline-block px-2 py-1.5">
          Falta material
        </p>
      )
    }
  </div>
</article>
